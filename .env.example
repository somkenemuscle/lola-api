NODE_ENV=development
PORT=4000

# Any Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lola_adeoti?schema=public"

# Comma-separated list of origins allowed to call the API (store, admin).
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Production only, e.g. ".lolaadeoti.com". Leave unset locally.
# COOKIE_DOMAIN=
